{
  "name": "tickets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "server": "tsx src/server/main.ts",
    "build:ui": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "npm run build:ui && tsx src/server/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bash scripts/run-e2e.sh",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pdf-lib": "^1.17.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
